# ============================================
# Sovereign Order Intelligence - Environment
# ============================================

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b

# Tavily API (for web search)
# Get your API key at: https://tavily.com
TAVILY_API_KEY=your-tavily-api-key

# Serper.dev API (for Google Search)
# Get your API key at: https://serper.dev
SERPER_API_KEY=your-serper-api-key

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=vendor_intelligence
ANONYMIZED_TELEMETRY=False

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard Settings
DASHBOARD_PORT=8501

# Grading Thresholds
RELEVANCE_THRESHOLD=0.7
CONFIDENCE_THRESHOLD=0.8
MAX_WEB_SEARCHES=5
# true = always run one web research pass, even when local data is sufficient
ALWAYS_WEB_SEARCH=false

# API security (REST API)
# When API_KEY is set, every request (except /, /health, /docs) must send header: X-API-Key
API_KEY=
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
MAX_UPLOAD_MB=20

# Document Processing
MAX_DOCUMENT_SIZE_MB=50
SUPPORTED_FORMATS=pdf,png,jpg,jpeg,docx

# Performance
BATCH_SIZE=10
MAX_CONCURRENT_REQUESTS=5
CACHE_TTL_SECONDS=3600

# Downloads Directory (for scraped documents)
DOWNLOADS_DIR=./data/downloads

